@model BookContextViewModel
@using Markdig

<div id="book-context-@Model.BookId">
    @if (string.IsNullOrWhiteSpace(Model.Context))
    {
        <div class="flex items-center gap-2">
            <sl-spinner id="context-spinner-@Model.BookId"
                        class="htmx-indicator"
                        style="font-size: 1rem; color: rgba(255,255,255,0.5);"></sl-spinner>
            <sl-button variant="default" outline size="small"
                       hx-post="/notes/book/@Model.BookId/context/generate"
                       hx-target="#book-context-@Model.BookId"
                       hx-swap="outerHTML"
                       hx-indicator="#context-spinner-@Model.BookId"
                       hx-disabled-elt="this">
                <sl-icon slot="prefix" name="stars"></sl-icon>
                Generate Context
            </sl-button>
        </div>
    }
    else
    {
        var contextHtml = Markdown.ToHtml(Model.Context!, new MarkdownPipelineBuilder().UseAdvancedExtensions().Build());

        <sl-button class="book-context-fullscreen-btn"
                   variant="default"
                   outline
                   size="small"
                   data-dialog-id="book-context-dialog-@Model.BookId">
            <sl-icon slot="prefix" name="book"></sl-icon>
            See Book Context
        </sl-button>

        <sl-dialog id="book-context-dialog-@Model.BookId"
                   class="book-context-dialog"
                   label="@Model.Title — @Model.Author"
                   no-header>
            <div class="paper-style--modal">
                <div class="book-context-modal-content">
                    <header class="book-context-modal-header">
                        <div>
                            <h2 class="font-title">@Model.Title</h2>
                            <p>@Model.Author</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-1">
                            <sl-tooltip content="Regenerate context with AI">
                                <sl-icon-button name="arrow-counterclockwise"
                                                label="Regenerate context"
                                                hx-post="/notes/book/@Model.BookId/context/generate"
                                                hx-target="#book-context-@Model.BookId"
                                                hx-swap="outerHTML"
                                                hx-indicator="#context-spinner-@Model.BookId"></sl-icon-button>
                            </sl-tooltip>
                            <sl-tooltip content="This context was generated by AI and may contain inaccuracies.">
                                <sl-icon name="question-circle"
                                         style="font-size: 0.9rem; color: rgba(255,255,255,0.4); cursor: help;"></sl-icon>
                            </sl-tooltip>
                            <sl-spinner id="context-spinner-@Model.BookId"
                                        class="htmx-indicator"
                                        style="font-size: 0.9rem; color: rgba(255,255,255,0.5);"></sl-spinner>
                            <sl-icon-button class="book-context-dialog-close-btn"
                                            name="x-lg"
                                            label="Close book context"></sl-icon-button>
                        </div>
                    </header>
                    <div class="book-context-modal-body text-lg leading-relaxed prose prose-invert max-w-none"
                         style="color: rgba(255,255,255,0.75);">
                        @Html.Raw(contextHtml)
                    </div>
                </div>
            </div>
        </sl-dialog>
    }
</div>
